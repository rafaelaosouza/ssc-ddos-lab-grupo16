alert tcp any any -> any 80 (msg:"SYN flood detectado"; flags:S; flow:to_server; threshold:type both, track by_dst, count 100, seconds 5; sid:1000001; rev:1;)
alert tcp any any -> any 80 (msg:"Slowloris detectado - muitas conexoes de uma origem"; flags:S; flow:to_server; threshold:type both, track by_src, count 50, seconds 10; sid:1000002; rev:1;)
